TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_BOT_USERNAME=your_qr_bot
# Numeric ID of the private channel, normally beginning with -100.
TELEGRAM_CONTENT_CHANNEL_ID=-1001234567890
# Use a long random value containing only A-Z, a-z, 0-9, underscore, and hyphen.
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-webhook-secret
# Use long, unique values. Do not reuse these credentials elsewhere.
MONGO_ROOT_USERNAME=qr_root
MONGO_ROOT_PASSWORD=replace-with-long-random-root-password
MONGO_APP_USERNAME=qr_app
MONGO_APP_PASSWORD=replace-with-long-random-app-password
QR_BOT_LOG_LEVEL=INFO
