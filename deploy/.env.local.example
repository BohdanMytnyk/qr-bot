# Create a separate bot with BotFather for local/pre testing.
LOCAL_TELEGRAM_BOT_TOKEN=123456789:replace-with-local-bot-token
LOCAL_TELEGRAM_BOT_USERNAME=your_local_qr_bot
# Use a separate private channel and make the local bot an administrator.
LOCAL_TELEGRAM_CONTENT_CHANNEL_ID=-1001234567890
# Only updates from this Telegram user ID are processed by the local bot.
LOCAL_TELEGRAM_OWNER_ID=441341235
QR_BOT_LOG_LEVEL=INFO
